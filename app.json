{
  "expo": {
    "name": "YuGiPocket",
    "slug": "yugipocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "yugipocket",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yugipocket.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La fotocamera viene usata solo per scansionare i QR code di scambio carte generati da un altro giocatore."
      }
    },
    "android": {
      "package": "com.yugipocket.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "La fotocamera viene usata solo per scansionare i QR code di scambio carte generati da un altro giocatore.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E3",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
